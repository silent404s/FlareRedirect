# ==============================================================================
# FlareRedirect - Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root to override default settings.
#
# SECURITY NOTICE:
# In accordance with FlareRedirect's Zero-Storage security policy,
# Cloudflare API tokens MUST NOT be placed in this file. Tokens are strictly
# managed in volatile RAM and zeroed on session disconnect/app exit.
# ==============================================================================

# Application Metadata
APP_NAME=FlareRedirect
APP_VERSION=1.2.0
APP_ENV=production

# Cloudflare API Base Endpoint
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# HTTP Client Timeouts (in seconds)
CF_TIMEOUT_CONNECT=10.0
CF_TIMEOUT_READ=25.0
CF_TIMEOUT_WRITE=15.0
CF_TIMEOUT_POOL=10.0

# HTTP User-Agent Header
CF_USER_AGENT=FlareRedirect/1.2.0

# Cloudflare API Pagination (Maximum 50 recommended by Cloudflare)
CF_ZONES_PER_PAGE=50

# Maximum In-Memory Audit Log Entries
MAX_AUDIT_LOG_ENTRIES=2000

